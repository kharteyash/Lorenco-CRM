# Copy this file to ".env" and fill in your values, then restart the server.

# ---- Database (required) ----
# A Postgres connection string. Easiest free option: https://neon.tech
# Create a project, copy the connection string (it looks like the line below).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ---- Server ----
# Port to listen on (defaults to 3000).
# PORT=3000

# Set to "production" when deployed (enables secure cookies). Most hosts set this automatically.
# NODE_ENV=production

# TLS to the database is verified by default. Escape hatches if a provider needs them:
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----...     # a custom CA (PEM) to trust
# DATABASE_SSL_NO_VERIFY=true                          # last resort — disables verification

# ---- Send as your Gmail (recommended) ----
# Powers the "Connect Gmail" button on the Automatic Emails page, so each user
# sends the weekly email from their OWN Gmail address via the Gmail API.
# Set up at https://console.cloud.google.com -> APIs & Services:
#   1) Create a project; enable the "Gmail API".
#   2) OAuth consent screen: External; add yourself as a test user.
#   3) Credentials -> OAuth client ID -> Web application.
#   4) Add an Authorized redirect URI that EXACTLY matches GOOGLE_REDIRECT_URI:
#        Local:      http://localhost:3000/api/google/callback
#        Production: https://YOUR-APP.onrender.com/api/google/callback
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Optional: encrypt stored OAuth tokens at rest (any strong passphrase).
# TOKEN_ENC_KEY=some-long-random-string

# ---- Weekly blasts via an SMTP relay (STRONGLY recommended for 100+ lists) ----
# When configured, the weekly mailing-list blast sends through this relay
# (bulk-safe); 1:1 lead emails still go through each user's connected Gmail.
# Consumer Gmail flags 100+ message bursts as spam and bounces them with
# "You have reached a limit for sending mail" — a relay is built for it.
# Free option that fits a weekly list of a few hundred: Brevo (300 emails/day).
#   1) Sign up at https://www.brevo.com (free, no card).
#   2) Verify your sender: Settings -> Senders & IPs -> add your email address
#      (e.g. the Gmail you send from) and click the confirmation they mail you.
#   3) Get SMTP credentials: Settings -> SMTP & API -> SMTP tab:
#        SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=587
#        SMTP_USER=<the login shown there>   SMTP_PASS=<the SMTP key>
#   4) SMTP_FROM must be the verified sender from step 2.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login
# SMTP_PASS=your-brevo-smtp-key
# SMTP_FROM=Your Name <you@yourdomain.com>

# Weekly sends fire from an internal hourly timer, but free hosts sleep when idle.
# For reliable weekly delivery, have an external cron hit this every few minutes:
#   GET https://YOUR-APP/api/cron/dispatch?key=CRON_SECRET   (e.g. cron-job.org)
# CRON_SECRET=set-a-long-random-string

# AI writer: the day after each weekly send, a fresh edition of the email is
# drafted automatically (and via the "Write next week's with AI" button).
# Models are tried in order until one answers:
#   GEMINI_API_KEY — native Google Gemini key; every Gemini text model, newest first
#   LLM7_API_KEY   — llm7.io key (OpenAI-compatible); gemini-named models first,
#                    then every other chat model it hosts
# GEMINI_API_KEY=
# LLM7_API_KEY=

# Weekly-email hero photo: each edition gets a photo matched to its topic.
# Works with no key (keyless Flickr-CC picker). For higher-quality, precisely
# on-topic photos, add a free Pexels key (https://www.pexels.com/api/ — instant):
# PEXELS_API_KEY=

# Public base URL for links inside emails (unsubscribe). Defaults to the origin
# of GOOGLE_REDIRECT_URI, so usually you don't need to set it.
# APP_URL=https://YOUR-APP.onrender.com
